	</string>
	<string id="ui_inv_intoxication_raise_light">
		<text>Slightly raises intoxication</text>
	</string>
	<string id="ui_inv_intoxication_raise">
		<text>Raises intoxication</text>
	</string>
	<string id="ui_inv_intoxication_raise_heavy">
		<text>Strongly raises intoxication</text>
	</string>
</string_table>