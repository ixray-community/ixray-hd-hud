[weapon_customize]
ui_functor     = ui_weapon_customize.open
xml            = weapon_customize.xml
refresh_ms     = 250
focus_zoom     = 1.9
rotate_step    = 30
snd_open       = interface\inv_open
snd_close      = interface\inv_close
snd_select     = interface\inv_properties
snd_attach     = interface\inv_attach_addon
snd_detach     = interface\inv_detach_addon
snd_error      = interface\inv_drop

[hotkey_layer.weapon_customize]
parent   = ui
priority = 150
block    = all
label    = kb_layer_weapon_customize

[hotkey.wc_slot_prev]
context  = weapon_customize
key      = kQ
gamepad  = cLB
options  = kb_grp_weapon_customize
label    = kb_wc_slot_prev
hint     = 10

[hotkey.wc_slot_next]
context  = weapon_customize
key      = kE
gamepad  = cRB
options  = kb_grp_weapon_customize
label    = kb_wc_slot_next
hint     = 11

[hotkey.wc_part_prev]
