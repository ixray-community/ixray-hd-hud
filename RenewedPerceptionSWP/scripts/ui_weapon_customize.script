this.NO_ID = 4294967295
this.CONTEXT = "weapon_customize"
this.UNDO_LIMIT = 32
this.wnd = nil
this.cfg = nil
this.sounds = {}
this.hooks = {
	opened = nil,
	rebuilt = nil,
	missing_part = nil,
	show_missing = nil,
}

this.ACTIONS = {
	wc_slot_prev = "action_slot_prev",
	wc_slot_next = "action_slot_next",
	wc_part_prev = "action_part_prev",
	wc_part_next = "action_part_next",
	wc_apply = "action_apply",
	wc_detach = "action_detach",
	wc_undo = "action_undo",
	wc_redo = "action_redo",
	wc_revert = "action_revert",
	wc_focus = "action_focus",
	wc_reset_view = "action_reset_view",
	wc_rotate_left = "action_rotate_left",
	wc_rotate_right = "action_rotate_right",
	wc_zoom_in = "action_zoom_in",
	wc_zoom_out = "action_zoom_out",
	wc_close = "action_close",
}

function tr(id)
	return game.translate_string(id)
end

function trim(value)
	return (string.gsub(value or "", "^%s*(.-)%s*$", "%1"))
end

function split(value)
	local result = {}
	for item in string.gmatch(value or "", "[^,]+") do
		item = trim(item)
		if item ~= "" then
			result[#result + 1] = item
		end
	end
	return result
end

function ini_string(section, key, default)
	local ini = system_ini()
	if not section or not ini:section_exist(section) or not ini:line_exist(section, key) then
		return default
	end
	local ok, value = pcall(ini.r_string, ini, section, key)
	if ok and value ~= nil then
		return trim(value)
	end
	return default
end

function ini_number(section, key, default)
	return tonumber(ini_string(section, key, nil)) or default
end

function ini_bool(section, key, default)
	local value = ini_string(section, key, nil)
	if value == nil then
		return default
	end
	value = string.lower(value)
	return value == "true" or value == "1" or value == "on" or value == "yes"
end

function show_missing()
	if get_console():get_bool("g_god") then
		return true
	end
	return this.hooks.show_missing and this.hooks.show_missing() or false
end

function load_config()
	local s = "weapon_customize"
	local cfg = {
		xml = ini_string(s, "xml", "weapon_customize.xml"),
		refresh_ms = ini_number(s, "refresh_ms", 250),
		focus_zoom = ini_number(s, "focus_zoom", 1.9),
		rotate_step = math.rad(ini_number(s, "rotate_step", 30)),
		sounds = {},
		groups = {},
		slots = {},
		stat_sets = {},
		stat_max = 0,
	}

	for _, name in ipairs({"open", "close", "select", "attach", "detach", "error"}) do
		cfg.sounds[name] = ini_string(s, "snd_" .. name, nil)
	end

	local xml = CScriptXmlInit()
	xml:ParseFile(cfg.xml)

	local function attr(path, index, name, default)
		local value = xml:ReadAttribute(path, index, name)
		if value == nil or value == "" then
			return default
		end
		return value
	end

	local function flag(path, index, name)
		local value = attr(path, index, name, "0")
		return value == "1" or value == "true"
	end

	local function each(list, item, fn, list_index)
		list_index = list_index or 0
		local count = xml:GetNodesNum(list, list_index, item)
		if count <= 0 or not xml:NavigateToNode(list, list_index) then
			return
		end
		for i = 0, count - 1 do
			fn(i)
		end
		xml:NavigateToRoot()
	end

	each("groups", "group", function(i)
		local id = attr("group", i, "id", nil)
		if id then
			cfg.groups[id] = {
				label = attr("group", i, "label", id),
				order = tonumber(attr("group", i, "order", "100")) or 100,
			}
		end
	end)

	each("slots", "slot", function(i)
		local bone = attr("slot", i, "bone", nil)
		if bone then
			local list = cfg.slots[bone]
			if not list then
				list = {}
				cfg.slots[bone] = list
			end
			list[#list + 1] = {
				owners = split(attr("slot", i, "owner", "")),
				label = attr("slot", i, "label", bone),
				group = attr("slot", i, "group", "other"),
				order = tonumber(attr("slot", i, "order", "1000")) or 1000,
			}
		end
	end)

	local set_index = 0
	while xml:NavigateToNode("stats", set_index) do
		xml:NavigateToRoot()
		local kind = attr("stats", set_index, "for", "all")
		local set = cfg.stat_sets[kind] or {}
		cfg.stat_sets[kind] = set
		each("stats", "stat", function(i)
		local id = attr("stat", i, "id", tostring(i))
		set[#set + 1] = {
			id = id,
			label = attr("stat", i, "label", id),
			key = attr("stat", i, "key", ""),
			mode = attr("stat", i, "mode", "sum"),
			include_root = flag("stat", i, "include_root"),
			format = attr("stat", i, "format", "%.2f"),
			unit = attr("stat", i, "unit", nil),
			better = attr("stat", i, "better", "none"),
			hide_zero = flag("stat", i, "hide_zero"),
			hide_default = flag("stat", i, "hide_default"),
			empty = attr("stat", i, "empty", "wc_none"),
		}
		end, set_index)
		cfg.stat_max = math.max(cfg.stat_max, #set)
		set_index = set_index + 1
	end
	xml:NavigateToRoot()

	return cfg
end

function config()
	if not this.cfg then
		this.cfg = load_config()
	end
	return this.cfg
end

function play(name)
	local path = config().sounds[name]
	if not path or path == "" or not db.actor then
		return
	end
	local snd = this.sounds[path]
	if snd == nil then
		local ok, result = pcall(sound_object, path)
		snd = ok and result or false
		this.sounds[path] = snd
	end
	if snd then
		snd:play(db.actor, 0, sound_object.s2d)
	end
end

function owner_matches(section, owners)
	for _, pattern in ipairs(owners) do
		if string.sub(pattern, -1) == "*" then
			local prefix = string.sub(pattern, 1, -2)
			if string.sub(section, 1, #prefix) == prefix then
				return true
			end
		elseif pattern == section then
			return true
		end
	end
	return false
end

function slot_meta(bone, owner_section)
	local list = config().slots[bone]
	if list then
		local fallback = nil
		for _, entry in ipairs(list) do
			if #entry.owners == 0 then
				fallback = fallback or entry
			elseif owner_section and owner_matches(owner_section, entry.owners) then
				return entry
			end
		end
		if fallback then
			return fallback
		end
	end
	return {label = bone, group = "other", order = 1000}
end

function root_kind(obj)
	if obj and obj:is_weapon() then
		return "weapon"
	end
	return "attachment"
end

function stat_set(kind)
	local sets = config().stat_sets
	return sets[kind] or sets.all or {}
end

function group_meta(id)
	return config().groups[id] or config().groups.other or {label = "wc_group_other", order = 100}
end

function part_name(section, short)
	local key = short and ini_string(section, "inv_name_short", nil) or nil
	key = key or ini_string(section, "inv_name", nil) or section
	return tr(key)
end

function part_description(section)
	local key = ini_string(section, "description", nil)
	if not key then
		return ""
	end
	local text = tr(key)
	return text ~= key and text or ""
end

function slot_label(slot)
	local label = tr(slot.meta.label)
	if label == slot.meta.label then
		label = slot.bone
	end
	return label
end

