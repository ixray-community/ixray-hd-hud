this.next_poll_time = 0

-- ################################
-- #           HELPERS            #
-- ################################

function tr(id)
	return game.translate_string(id)
end

function actor_ready()
	return db.actor ~= nil and db.storage[db.actor:id()] ~= nil
end

function pget(key, default)
	if not actor_ready() then
		return default
	end
	return xr_logic.pstor_retrieve(db.actor, key, default)
end

function pset(key, value)
	if actor_ready() then
		xr_logic.pstor_store(db.actor, key, value)
	end
end

function pstor_table()
	if not actor_ready() then
		return nil
	end
	return db.storage[db.actor:id()].pstor
end

function safe_actor_call(method_name, default)
	if not db.actor then
		return default
	end
	local ok, value = pcall(function ()
		return db.actor[method_name](db.actor)
	end)
	if ok and value ~= nil then
		return value
	end
	return default
end

function clamp(value, low, high)
	return math.max(low, math.min(high, value))
end

function format_number(value)
	local sign, digits = string.match(tostring(math.floor(value or 0)), "^(%-?)(%d+)$")
	if not digits then
		return tostring(value)
	end
	local grouped = string.reverse(string.gsub(string.reverse(digits), "(%d%d%d)", "%1 "))
	return sign .. string.gsub(grouped, "^%s+", "")
end

function item_name(section)
	local ini = system_ini()
	if section and ini:section_exist(section) and ini:line_exist(section, "inv_name") then
		return tr(ini:r_string(section, "inv_name"))
	end
	return tostring(section)
end

function minutes_since_start()
	return math.floor(game.get_game_time():diffSec(level.get_start_time()) / 60)
end

function start_clock_minutes()
	local _, _, _, hours, minutes = level.get_start_time():get(0, 0, 0, 0, 0, 0, 0)
	return (hours or 0) * 60 + (minutes or 0)
end

function current_surges()
	return xr_statistic.actor_statistic.surges or 0
end

function current_secrets()
	return xr_statistic.actor_statistic.founded_secrets or 0
end

function object_level_name(se_obj)
	if not se_obj then
		return nil
	end
	local vertex = game_graph():vertex(se_obj.m_game_vertex_id)
	return vertex and alife():level_name(vertex:level_id())
end

function count_infos(list)
	local count = 0
	for _, info in ipairs(list) do
		if type(info) == "table" then
			for _, alternative in ipairs(info) do
				if has_alife_info(alternative) then
					count = count + 1
					break
				end
			end
		elseif has_alife_info(info) then
			count = count + 1
		end
	end
	return count
end

function join_by_level(by_level)
	local parts = {}
	for level_name, count in pairs(by_level) do
		table.insert(parts, string.format("%s %d", tr(level_name), count))
	end
	table.sort(parts)
	return table.concat(parts, ", ")
end

function is_actor(obj)
	return obj ~= nil and db.actor ~= nil and obj:id() == db.actor:id()
end

-- ################################
-- #          CHRONICLE           #
-- ################################

function add_chronicle(kind, arg)
	local head = math.floor(pget(this.KEY.chronicle_head, 0)) + 1
	pset(this.KEY.chronicle_head, head)
	pset(this.KEY.chronicle .. ((head - 1) % this.CHRONICLE_SIZE + 1),
		string.format("%d|%s|%s", minutes_since_start(), kind, arg or ""))
end

function format_stamp(minutes)
	local clock = (start_clock_minutes() + minutes) % 1440
	return string.format(tr("st_fr_stamp"), math.floor(minutes / 1440) + 1, math.floor(clock / 60), clock % 60)
end

function achievement_name(id)
	local ini = system_ini()
	if ini:section_exist(id) and ini:line_exist(id, "name") then
		return tr(ini:r_string(id, "name"))
	end
	return id
end

function chronicle_text(kind, arg)
	if kind == "kill_first" then
		return string.format(tr("st_fr_chr_kill_first"), tr("st_fr_mon_" .. arg))
	elseif kind == "knowledge" then
		local species, tier = string.match(arg, "^(.-):(%d)$")
		if species then
			return string.format(tr("st_fr_chr_knowledge"), tr("st_fr_mon_" .. species), tr("st_fr_tier_" .. tier))
		end
	elseif kind == "artefact" then
		return string.format(tr("st_fr_chr_artefact"), item_name(arg))
	elseif kind == "surge" then
		return string.format(tr("st_fr_chr_surge"), tr(arg))
	elseif kind == "stash" then
		return string.format(tr("st_fr_chr_stash"), tr(arg))
	elseif kind == "level" then
		return string.format(tr("st_fr_chr_level"), tr(arg))
	elseif kind == "rank" then
		return string.format(tr("st_fr_chr_rank"), tr("st_rank_" .. arg))
	elseif kind == "achievement" then
		return string.format(tr("st_fr_chr_achievement"), achievement_name(arg))
	end
	return tostring(arg)
end

function get_chronicle()
	local list = {}
	local head = math.floor(pget(this.KEY.chronicle_head, 0))
	for n = head, math.max(1, head - this.CHRONICLE_SIZE + 1), -1 do
		local raw = pget(this.KEY.chronicle .. ((n - 1) % this.CHRONICLE_SIZE + 1), nil)
		if type(raw) == "string" then
			local minutes, kind, arg = string.match(raw, "^(%-?%d+)|([^|]*)|(.*)$")
			if minutes then
				table.insert(list, {stamp = format_stamp(tonumber(minutes)), text = chronicle_text(kind, arg)})
			end
		end
	end
	return list
end

-- ################################
-- #           KNOWLEDGE          #
-- ################################

function species_kills(species_id)
	return math.floor(pget(this.KEY.kills .. species_id, 0))
end

function knowledge_tier(species_id, kills)
	local species = this.species_by_id[species_id]
	if not species or kills <= 0 then
		return 0
	end
	if kills >= species.tiers[2] then
		return 3
	elseif kills >= species.tiers[1] then
		return 2
	end
	return 1
end

function knowledge_bonus(species_id)
	return this.TIER_DAMAGE_BONUS[knowledge_tier(species_id, species_kills(species_id))] or 0
end

function get_knowledge()
	local list = {}
	for _, species in ipairs(this.SPECIES) do
		local kills = species_kills(species.id)
		if kills > 0 then
			local tier = knowledge_tier(species.id, kills)
			local notes = {tr("st_fr_note_" .. species.id .. "_1")}
			if tier >= 2 then
				table.insert(notes, tr("st_fr_note_" .. species.id .. "_2"))
			end
			if tier >= 3 then
				table.insert(notes, tr("st_fr_note_mastery"))
			end

			local entry = {
				name = tr("st_fr_mon_" .. species.id),
				icon = species.icon,
				kills = kills,
				tier = tier,
				tier_text = tr("st_fr_tier_" .. tier),
				next_text = tr("st_fr_knowledge_complete"),
				progress = 1,
				notes = table.concat(notes, "\\n"),
			}

			if tier < 3 then
				local goal = species.tiers[tier]
				local previous = tier == 1 and 1 or species.tiers[tier - 1]
				entry.next_text = string.format(tr("st_fr_knowledge_next"), tr("st_fr_tier_" .. (tier + 1)), goal - kills)
				entry.progress = clamp((kills - previous) / math.max(goal - previous, 1), 0, 1)
			end

			if (this.TIER_DAMAGE_BONUS[tier] or 0) > 0 then
				entry.tier_text = entry.tier_text .. " " .. tr("st_fr_sep") .. " "
					.. string.format(tr("st_fr_bonus_damage"), math.floor(this.TIER_DAMAGE_BONUS[tier] * 100 + 0.5))
			end

			table.insert(list, entry)
		end
	end
	table.sort(list, function (a, b)
		if a.tier ~= b.tier then
			return a.tier > b.tier
		end
		return a.kills > b.kills
	end)
	return list, #this.SPECIES
end

-- ################################
-- #        ACHIEVEMENTS          #
-- ################################

function load_achievements()
	if this.achievements_cache then
		return this.achievements_cache
	end
	this.achievements_cache = {}
	local ini = system_ini()
	if not ini:section_exist("achievements") then
		return this.achievements_cache
	end
	for i = 0, ini:line_count("achievements") - 1 do
		local ok, id = ini:r_line("achievements", i, "", "")
		if ok and id and id ~= "" and ini:section_exist(id) then
			local module_name, function_name = string.match(
				ini:line_exist(id, "functor") and ini:r_string(id, "functor") or "", "^([%w_]+)%.([%w_]+)$")
			table.insert(this.achievements_cache, {
				id = id,
				module_name = module_name,
				function_name = function_name,
				name = ini:line_exist(id, "name") and ini:r_string(id, "name") or id,
				desc = ini:line_exist(id, "desc") and ini:r_string(id, "desc") or "",
				hint = ini:line_exist(id, "hint") and ini:r_string(id, "hint") or "",
				icon = ini:line_exist(id, "icon") and ini:r_string(id, "icon") or "",
			})
		end
	end
	return this.achievements_cache
end

-- Achievement functors grant info portions and bonuses as a side effect.
function call_functor(achievement)
	local module = achievement.module_name and _G[achievement.module_name]
	local fn = module and module[achievement.function_name]
	if type(fn) ~= "function" then
		return false
	end
	local ok, result = pcall(fn)
	return ok and result == true
end

function poll_achievements(announce)
	for _, achievement in ipairs(load_achievements()) do
		if not pget(this.KEY.gained .. achievement.id, false) and call_functor(achievement) then
			pset(this.KEY.gained .. achievement.id, true)
			if announce then
				add_chronicle("achievement", achievement.id)
			end
		end
	end
end

function artefact_types()
	local found, total = 0, 0
	for _, is_found in pairs(xr_statistic.artefacts_table or {}) do
		total = total + 1
		if is_found then
			found = found + 1
		end
	end
	return found, total
end

function goal_progress(definition)
	if not definition then
		return nil
	end
	if definition.steps then
		return count_infos(definition.steps), #definition.steps
	elseif definition.count then
		return math.min(count_infos(definition.count), definition.need), definition.need
	elseif definition.items then
		local found = 0
		for _, section in ipairs(definition.items) do
			if db.actor:object(section) ~= nil then
				found = found + 1
			end
		end
		return found, #definition.items
	elseif definition.money then
		return math.min(db.actor:money(), definition.money), definition.money
	elseif definition.counter then
		return math.min(math.floor(pget(definition.counter, 0)), definition.need), definition.need
	elseif definition.artefacts then
		return artefact_types()
	end
	return nil
end

function goal_state(definition, gained, current)
	if gained then
		return "done"
	elseif definition and definition.blocked_by and count_infos(definition.blocked_by) > 0 then
		return "blocked"
	elseif current > 0 then
		return "progress"
	end
	return "new"
end

function get_goals()
	local list = {}
	local done_count = 0
	for _, achievement in ipairs(load_achievements()) do
		local definition = this.GOALS[achievement.id]
		local gained = pget(this.KEY.gained .. achievement.id, false)
		local current, maximum = goal_progress(definition)
		if not current then
			current, maximum = gained and 1 or 0, 1
		end
		if gained then
			current = maximum
			done_count = done_count + 1
		end

		local goal = {
			id = achievement.id,
			name = tr(achievement.name),
			icon = achievement.icon,
			goal = tr("st_fr_goal_" .. achievement.id),
			reward = tr(achievement.hint),
			current = current,
			maximum = maximum,
			ratio = maximum > 0 and current / maximum or 0,
			progress_text = string.format("%d/%d", current, maximum),
			state = goal_state(definition, gained, current),
		}
		if goal.goal == "st_fr_goal_" .. achievement.id then
			goal.goal = tr(achievement.desc)
		end
		if definition and definition.money then
			goal.progress_text = string.format("%s/%s", format_number(current), format_number(maximum))
		end
		goal.show_reward = goal.state == "done" or goal.state == "progress"

		table.insert(list, goal)
	end
	table.sort(list, function (a, b)
		if a.state ~= b.state then
			return this.GOAL_STATE_ORDER[a.state] < this.GOAL_STATE_ORDER[b.state]
		end
		if a.ratio ~= b.ratio then
			return a.ratio > b.ratio
		end
		return a.name < b.name
	end)
	return list, done_count
end

-- ################################
-- #       ZONE AND PROFILE       #
-- ################################

function load_rank_table()
	if this.rank_table_cache then
		return this.rank_table_cache
	end
	this.rank_table_cache = {}
	local tokens = {}
	for token in string.gmatch(system_ini():r_string("game_relations", "rating"), "[^,%s]+") do
		table.insert(tokens, token)
	end
	local lower = 0
	for i = 1, #tokens, 2 do
		local upper = tonumber(tokens[i + 1])
		table.insert(this.rank_table_cache, {name = tokens[i], lower = lower, upper = upper})
		lower = upper or lower
	end
	return this.rank_table_cache
end

-- Returns rank name, next rank name, points left and progress inside the current rank.
function rank_info()
	local rank = db.actor:character_rank()
	local ranks = load_rank_table()
	for i, entry in ipairs(ranks) do
		if not entry.upper then
			return entry.name, nil, nil, 1
		elseif rank < entry.upper then
			return entry.name, ranks[i + 1] and ranks[i + 1].name, entry.upper - rank,
				clamp((rank - entry.lower) / math.max(entry.upper - entry.lower, 1), 0, 1)
		end
	end
	return "master", nil, nil, 1
end

function playstyle_id()
	local stats = xr_statistic.actor_statistic
	local scores = {
		hunter = (stats.killed_monsters or 0) / 60,
		cutthroat = (stats.killed_stalkers or 0) / 60,
		sharpshooter = safe_actor_call("actor_headshots", 0) / 40,
		medic = safe_actor_call("actor_help_wounded", 0) / 6,
		prospector = (stats.artefacts_founded or 0) / 15,
		treasure = (stats.founded_secrets or 0) / 8,
		dealer = safe_actor_call("actor_money_earned", 0) / 150000,
		wanderer = safe_actor_call("actor_distance_km", 0) / 120,
	}
	local best_id, best_score = "newbie", this.STYLE_MIN_SCORE
	for id, score in pairs(scores) do
		if score > best_score then
			best_id, best_score = id, score
		end
	end
	return best_id
end

function get_profile()
	local rank_name, next_rank, points_left, progress = rank_info()
	local profile = {
		name = db.actor:character_name(),
		icon = db.actor:character_icon(),
		rank_text = string.format(tr("st_fr_rank_max"), tr("st_rank_" .. rank_name)),
		rank_progress = progress,
		style_text = string.format(tr("st_fr_style"), tr("st_fr_style_" .. playstyle_id())),
		money_text = string.format(tr("st_fr_money"), format_number(db.actor:money())),
	}
	if next_rank and points_left then
		profile.rank_text = string.format(tr("st_fr_rank_next"), tr("st_rank_" .. rank_name), tr("st_rank_" .. next_rank), points_left)
	end
	return profile
end

function surge_row()
	local manager = surge_manager.get_surge_manager()
	if not manager or not manager.last_surge_time then
		return nil
	end
	if manager.started then
		return {caption = tr("st_fr_row_surge"), value = tr("st_fr_surge_now"), color = {230, 90, 70}}
	end
	local hours = game.get_game_time():diffSec(manager.last_surge_time) / 3600
	-- surge_manager waits 2-4 h before the first surge and 12-24 h between the next ones.
	local min_hours, max_hours = 12, 24
	if current_surges() == 0 then
		min_hours, max_hours = 2, 4
	end
	local row = {caption = tr("st_fr_row_surge"), risk = "very_high", color = {230, 90, 70}}
	if hours < min_hours * 0.5 then
		row.risk, row.color = "low", {120, 190, 120}
	elseif hours < min_hours then
		row.risk, row.color = "medium", {210, 200, 110}
	elseif hours < (min_hours + max_hours) * 0.5 then
		row.risk, row.color = "high", {230, 150, 70}
	end
	row.value = string.format(tr("st_fr_surge_value"), math.floor(hours), tr("st_fr_risk_" .. row.risk))
	return row
end

function fields_row()
	local current = current_surges()
	local tracked, refreshed, by_level = 0, 0, {}
	for key, value in pairs(pstor_table() or {}) do
		if type(value) == "string" and string.sub(key, 1, #this.KEY.field) == this.KEY.field then
			local level_name, surges_at_take = string.match(value, "^([^|]+)|(%d+)$")
			if level_name then
				tracked = tracked + 1
				if current > tonumber(surges_at_take) then
					refreshed = refreshed + 1
					by_level[level_name] = (by_level[level_name] or 0) + 1
				end
			end
		end
	end
	if tracked == 0 then
		return {caption = tr("st_fr_row_fields"), value = tr("st_fr_none"), detail = tr("st_fr_fields_hint")}
	end
	local row = {caption = tr("st_fr_row_fields"), value = string.format("%d/%d", refreshed, tracked)}
	if refreshed > 0 then
		row.color = {150, 210, 120}
		row.detail = join_by_level(by_level)
	end
	return row
end

function stashes_row()
	local manager = treasure_manager.get_treasure_manager()
	local count, by_level = 0, {}
	for treasure_id, secret in pairs(manager and manager.secrets or {}) do
		if secret.given and not secret.checked and (secret.to_find or 0) > 0 then
			count = count + 1
			local restrictor_id = manager.secret_restrs and manager.secret_restrs[treasure_id]
			local level_name = restrictor_id and object_level_name(alife():object(restrictor_id))
			if level_name then
				by_level[level_name] = (by_level[level_name] or 0) + 1
			end
		end
	end
	local row = {caption = tr("st_fr_row_stashes"), value = tostring(count)}
	if count > 0 then
		row.color = {220, 200, 120}
		row.detail = join_by_level(by_level)
	end
	return row
end

function get_zone_rows()
	local stats = xr_statistic.actor_statistic
	local minutes = minutes_since_start()
	local found_types, total_types = artefact_types()
	-- surge_row returns nil before the surge manager is initialized, so it is appended separately.
	local rows = {
		{caption = tr("st_fr_row_time"),
			value = string.format(tr("st_fr_time_value"), math.floor(minutes / 1440), math.floor(minutes % 1440 / 60))},
	}
	table.insert(rows, surge_row())
	for _, row in ipairs({fields_row(), stashes_row(),
		{caption = tr("st_fr_row_artefacts"),
			value = string.format(tr("st_fr_artefacts_value"), stats.artefacts_founded or 0, found_types, total_types)},
		{caption = tr("st_fr_row_money_flow"),
			value = string.format("%s / %s", format_number(safe_actor_call("actor_money_earned", 0)), format_number(safe_actor_call("actor_money_spent", 0)))},
		{caption = tr("st_fr_row_quests"), value = tostring(stats.completed_quests or 0)},
		{caption = tr("st_fr_row_kills"),
			value = string.format("%d / %d", stats.killed_monsters or 0, stats.killed_stalkers or 0)},
		{caption = tr("st_fr_row_headshots"), value = tostring(safe_actor_call("actor_headshots", 0))},
		{caption = tr("st_fr_row_wounded"), value = tostring(safe_actor_call("actor_help_wounded", 0))},
		{caption = tr("st_fr_row_distance"),
			value = string.format(tr("st_fr_distance_value"), safe_actor_call("actor_distance_km", 0))},
		{caption = tr("st_fr_row_deaths"), value = tostring(safe_actor_call("actor_deaths", 0))},
	}) do
		table.insert(rows, row)
	end
	return rows
end

-- Same switch as InventoryHolsterPistolSlotActiveInSettings() in the engine
function holster_slot_active()
	local ini = system_ini()
	return ini:section_exist("inventory") and ini:line_exist("inventory", "slot_active_16")
		and ini:r_bool("inventory", "slot_active_16")
end

function get_gear_slots()
	if this.gear_slots_cache then
		return this.gear_slots_cache
	end
	this.gear_slots_cache = {{slot = this.SLOT_PRIMARY, label = "st_fr_gear_primary"}}
	if holster_slot_active() then
		table.insert(this.gear_slots_cache, {slot = this.SLOT_SIDEARM, label = "st_fr_gear_second"})
		table.insert(this.gear_slots_cache, {slot = this.SLOT_HOLSTER, label = "st_fr_gear_secondary"})
	else
		table.insert(this.gear_slots_cache, {slot = this.SLOT_SIDEARM, label = "st_fr_gear_secondary"})
	end
	table.insert(this.gear_slots_cache, {slot = this.SLOT_OUTFIT, label = "st_fr_gear_outfit"})
	table.insert(this.gear_slots_cache, {slot = this.SLOT_HELMET, label = "st_fr_gear_helmet"})
	return this.gear_slots_cache
end

function get_gear()
	local list = {}
	for _, entry in ipairs(get_gear_slots()) do
		local item = db.actor:item_in_slot(entry.slot)
		local row = {label = tr(entry.label)}
		if item then
			row.condition = clamp(item:condition(), 0, 1)
			row.name = item_name(item:section())
			row.value = string.format("%d%%", math.floor(row.condition * 100 + 0.5))
			row.warn = row.condition < this.REPAIR_THRESHOLD
		end
		table.insert(list, row)
	end
	return list
end

-- Returns rows with the change since the previous call, then stores the current values as the new baseline
function take_relations_snapshot()
	local list = {}
	for _, community in ipairs(this.FACTIONS) do
		local value = relation_registry.community_relation(community, db.actor:character_community())
			+ relation_registry.community_goodwill(community, db.actor:id())
		local previous = pget(this.KEY.faction .. community, nil)
		pset(this.KEY.faction .. community, value)

		local row = {
			name = tr("st_fr_fac_" .. community),
			value = value,
			position = clamp((value + this.RELATION_RANGE) / (2 * this.RELATION_RANGE) * 100, 0, 100),
			status = tr("st_fr_rel_neutral"),
			color = {200, 190, 130},
			delta = previous and math.floor(value - previous) or 0,
		}
		if value >= this.RELATION_FRIEND then
			row.status, row.color = tr("st_fr_rel_friend"), {120, 200, 120}
		elseif value <= this.RELATION_ENEMY then
			row.status, row.color = tr("st_fr_rel_enemy"), {220, 90, 80}
		end
		table.insert(list, row)
	end
	return list
end

-- ################################
-- #            EVENTS            #
-- ################################

function initialize_baseline()
	if pget(this.KEY.init, false) then
		return
	end
	-- Mark the current state as known so an existing save does not flood the chronicle
	pset(this.KEY.surges, current_surges())
	pset(this.KEY.secrets, current_secrets())
	pset(this.KEY.rank, (rank_info()))
	pset(this.KEY.level .. level.name(), true)
	poll_achievements(false)
	take_relations_snapshot()
	pset(this.KEY.init, true)
end

function poll()
	if not actor_ready() then
		return
	end
	initialize_baseline()

	local level_name = level.name()
	if not pget(this.KEY.level .. level_name, false) then
		pset(this.KEY.level .. level_name, true)
		add_chronicle("level", level_name)
	end

	if current_surges() > pget(this.KEY.surges, 0) then
		pset(this.KEY.surges, current_surges())
		add_chronicle("surge", level_name)
	end

	if current_secrets() > pget(this.KEY.secrets, 0) then
		pset(this.KEY.secrets, current_secrets())
		add_chronicle("stash", level_name)
	end

	local rank_name = rank_info()
	if rank_name ~= pget(this.KEY.rank, rank_name) then
		add_chronicle("rank", rank_name)
	end
	pset(this.KEY.rank, rank_name)

	poll_achievements(true)
end

function on_actor_update()
	if time_global() < this.next_poll_time then
		return
	end
	this.next_poll_time = time_global() + this.POLL_INTERVAL_MS
	poll()
end

function on_monster_death(victim, who)
	if not victim then
		return
	end
	this.pending_bonus_hits[victim:id()] = nil
	if not is_actor(who) then
		return
	end
	local species = xr_statistic.monster_classes[victim:clsid()]
	if not this.species_by_id[species] then
		return
	end
	local kills = species_kills(species) + 1
	pset(this.KEY.kills .. species, kills)
	if kills == 1 then
		add_chronicle("kill_first", species)
	end
	local tier = knowledge_tier(species, kills)
	if tier > 1 and tier > knowledge_tier(species, kills - 1) then
		add_chronicle("knowledge", species .. ":" .. tier)
	end
end

function on_npc_death(victim, who)
	if not victim or not is_actor(who) then
		return
	end
	local community = victim:character_community()
	if community and community ~= "" then
		pset(this.KEY.human_kills .. community, math.floor(pget(this.KEY.human_kills .. community, 0)) + 1)
	end
end

-- The binder clears the artefact-to-field link right after this callback.
function on_item_take(item)
	if not item or not isArtefact(item) then
		return
	end
	local zone = bind_anomaly_zone.parent_zones_by_artefact_id[item:id()]
	if zone and zone.object then
		pset(this.KEY.field .. zone.object:name(), string.format("%s|%d", level.name(), current_surges()))
	end
	if xr_statistic.taken_artefacts[item:id()] == nil and xr_statistic.artefacts_table[item:section()] == false then
		add_chronicle("artefact", item:section())
	end
end

-- Knowledge bonus: an extra hit for a share of the damage. The engine sends script hits on the next
-- frame, so the callback of the bonus hit is skipped with a per-monster flag
function on_monster_hit(monster, amount, direction, who)
	if not monster or not is_actor(who) or not amount or amount <= 0 then
		return
	end
	if this.pending_bonus_hits[monster:id()] then
		this.pending_bonus_hits[monster:id()] = nil
		return
	end
	if not monster:alive() then
		return
	end
	local species = xr_statistic.monster_classes[monster:clsid()]
	local bonus = species and knowledge_bonus(species) or 0
	if bonus <= 0 then
		return
	end
	local h = hit()
	h.draftsman = db.actor
	h.type = hit.fire_wound
	h.direction = monster:position():sub(db.actor:position()):normalize()
	h.power = amount * bonus
	h.impulse = 0
	this.pending_bonus_hits[monster:id()] = true
	monster:hit(h)
end

function on_game_start()
	RegisterScriptCallback("actor_on_update", on_actor_update)
	RegisterScriptCallback("monster_on_death", on_monster_death)
	RegisterScriptCallback("monster_on_hit_callback", on_monster_hit)
	RegisterScriptCallback("npc_on_death_callback", on_npc_death)
	RegisterScriptCallback("actor_on_item_take", on_item_take)
end
