this.MODE_COMPASS = "compass_bar"
this.MODE_MINIMAP = "minimap"
this.SORT_CATEGORIES = "categories"
this.SORT_ORDERING = "ordering"

this.crosshair_ready = false
this._boot_compass_cached = false
this._boot_use_compass = true
this._boot_sort_cached = false
this._boot_sort_system = this.SORT_ORDERING
this.navigation_mode = this.MODE_COMPASS
this.inventory_sort_system = this.SORT_ORDERING
this.inventory_volume_enabled = false
this._console = nil

this.PDA_STAT_ALIAS = {
	money_earned = "money_earned",
	money_spent = "money_spent",
	help_stalkers = "help_wounded",
	help_wounded = "help_wounded",
	headshots = "headshots",
	player_deaths = "deaths",
	deaths = "deaths",
	death = "deaths",
	actor_deaths = "deaths",
	pda_stat_11 = "deaths",
	distance_km = "distance",
	distance = "distance",
	km = "distance",
	traveled_km = "distance",
	player_distance = "distance",
	pda_stat_12 = "distance",
}

this.PDA_STAT_GETTER = {
	money_earned = function (actor)
		return tostring(actor:actor_money_earned())
	end,
	money_spent = function (actor)
		return tostring(actor:actor_money_spent())
	end,
	help_wounded = function (actor)
		return tostring(actor:actor_help_wounded())
	end,
	headshots = function (actor)
		return tostring(actor:actor_headshots())
	end,
	deaths = function (actor)
		return tostring(actor:actor_deaths())
	end,
	distance = function (actor)
		return string.format("%.2f km", actor:actor_distance_km())
	end,
}

function run_console(command, arg)
	if ffx_console_utils and ffx_console_utils.execute_command then
		ffx_console_utils.execute_command(command, arg)
		return
	end

	if not this._console then
		this._console = get_console()
	end

	if tostring(arg) == "true" then
		arg = 1
	elseif tostring(arg) == "false" then
		arg = 0
	end

	this._console:execute(tostring(command) .. " " .. tostring(arg))
end

function read_boot_use_compass_bar()
	if this._boot_compass_cached then
		return this._boot_use_compass
	end

	this._boot_compass_cached = true
	this._boot_use_compass = true

	local ok, value = pcall(function ()
		local ini = ini_file("engine_external.ltx")
		if not ini or not ini:section_exist("ui") or not ini:line_exist("ui", "UseCompassBar") then
			return true
		end
		return ini:r_bool("ui", "UseCompassBar") == true
	end)

	if ok then
		this._boot_use_compass = value == true
	end

	return this._boot_use_compass
end

function read_boot_inventory_sort_system()
	if this._boot_sort_cached then
		return this._boot_sort_system
	end

	this._boot_sort_cached = true
	this._boot_sort_system = this.SORT_ORDERING

	local ok, value = pcall(function ()
		local ini = system_ini()
		if not ini or not ini:section_exist("inventory_sort") or not ini:line_exist("inventory_sort", "system") then
			return this.SORT_ORDERING
		end
		return ini:r_string("inventory_sort", "system")
	end)

	if ok and value then
		this._boot_sort_system = normalize_inventory_sort_system(value)
	end

	return this._boot_sort_system
end

function normalize_navigation_mode(value)
	if value == true or value == 1 or value == "1" or value == this.MODE_COMPASS then
		return this.MODE_COMPASS
	end
	return this.MODE_MINIMAP
end

function normalize_inventory_sort_system(value)
	if value == this.SORT_ORDERING or value == "ordering" then
		return this.SORT_ORDERING
	end
	return this.SORT_CATEGORIES
end

function get_maingame()
	if not db or not db.actor then
		return nil
	end
	if not ActorMenu or not ActorMenu.get_maingame then
		return nil
	end
	return ActorMenu.get_maingame()
end

function get_actor_menu()
	if not db or not db.actor then
		return nil
	end
	if not ActorMenu or not ActorMenu.get_actor_menu then
		return nil
	end
	return ActorMenu.get_actor_menu()
end

function apply_navigation_mode(value)
	this.navigation_mode = normalize_navigation_mode(value)

	local maingame = get_maingame()
	if not maingame then
		return
	end

	maingame:SetNavigationMode(this.navigation_mode == this.MODE_COMPASS)
end

function apply_inventory_sort_system(value)
	this.inventory_sort_system = normalize_inventory_sort_system(value)

	local actor_menu = get_actor_menu()
	if not actor_menu or not actor_menu.SetInventorySortSystem then
		return
	end

	actor_menu:SetInventorySortSystem(this.inventory_sort_system)
end

function normalize_inventory_volume(value)
	return value == true or value == 1 or value == "1"
end

function apply_inventory_volume(value)
	this.inventory_volume_enabled = normalize_inventory_volume(value)

	if level and level.set_inventory_volume_enabled then
		level.set_inventory_volume_enabled(this.inventory_volume_enabled)
	end
end

function read_boot_inventory_volume()
	local ok, value = pcall(function ()
		if level and level.is_inventory_volume_enabled then
			return level.is_inventory_volume_enabled()
		end
		local ini = ini_file("engine_external.ltx")
		if not ini or not ini:section_exist("gameplay") or not ini:line_exist("gameplay", "EnableInventoryVolume") then
			return false
		end
		return ini:r_bool("gameplay", "EnableInventoryVolume") == true
	end)

	if ok then
		return value == true
	end

	return false
end

function resolve_navigation_default_index()
	-- 1 = compass, 2 = minimap
	return this.navigation_mode == this.MODE_COMPASS and 1 or 2
end

function resolve_inventory_sort_default_index()
	-- 1 = categories, 2 = ordering
	return read_boot_inventory_sort_system() == this.SORT_ORDERING and 2 or 1
end

function on_main_menu_ready()
	this.crosshair_ready = true
end

function on_actor_hud_ready()
	this.crosshair_ready = true
	apply_navigation_mode(this.navigation_mode)
	apply_inventory_sort_system(this.inventory_sort_system)
	apply_inventory_volume(this.inventory_volume_enabled)

	local maingame = get_maingame()
	if maingame and maingame.IsCompassBarMode then
		this.navigation_mode = maingame:IsCompassBarMode() and this.MODE_COMPASS or this.MODE_MINIMAP
	end
end

function OnGetPdaStatById(stat_id)
	if not stat_id or stat_id == "" or not db or not db.actor then
		return ""
	end

	local key = this.PDA_STAT_ALIAS[stat_id]
	local getter = key and this.PDA_STAT_GETTER[key]
	if not getter then
		return ""
	end

	return getter(db.actor)
end

function register_options(_ref)
	local default_index = resolve_navigation_default_index()
	local sort_default_index = resolve_inventory_sort_default_index()

	_ref.register_option(nil, "hud_visible", "st_ui_hud_show", _ref.check_box(true),
		function (group, name, value)
			run_console("hud_draw", value)
		end
	)

	_ref.register_option("st_ui_group_hd_hud", "navigation_hud", "st_ui_hud_navigation_mode",
		_ref.combo_box(default_index, {
			_ref.combo_box_item("st_ui_hud_nav_compass", true, this.MODE_COMPASS),
			_ref.combo_box_item("st_ui_hud_nav_minimap", true, this.MODE_MINIMAP),
		}),
		function (group, name, value)
			apply_navigation_mode(value)
		end
	)

	_ref.register_option("st_ui_group_hd_hud", "navigation_visible", "st_ui_hud_show_navigation",
		_ref.check_box(true),
		function (group, name, value)
			run_console("hud_minimap", value)
		end
	)

	_ref.register_option("st_ui_group_hd_hud", "quick_slots_visible", "st_ui_hud_show_quick_slots", _ref.check_box(true),
		function (group, name, value)
			run_console("hud_hide_quick_slots", not value)
		end
	)

	_ref.register_option("st_ui_group_hd_hud", "contextual_status_widget", "st_ui_hud_contextual_status", _ref.check_box(false),
		function (group, name, value)
			run_console("hud_contextual_status", value)
		end
	)

	_ref.register_option("st_ui_group_hd_hud", "inventory_sort_system", "st_ui_hud_inventory_sort_system",
		_ref.combo_box(sort_default_index, {
			_ref.combo_box_item("st_ui_hud_inv_sort_categories", true, this.SORT_CATEGORIES),
			_ref.combo_box_item("st_ui_hud_inv_sort_ordering", true, this.SORT_ORDERING),
		}),
		function (group, name, value)
			apply_inventory_sort_system(value)
		end
	)

	_ref.register_option("st_ui_group_hd_hud", "inventory_volume", "st_ui_hud_inventory_volume",
		_ref.check_box(read_boot_inventory_volume()),
		function (group, name, value)
			apply_inventory_volume(value)
		end
	)

	_ref.register_option("st_ui_group_crosshair", "crosshair_visible", "st_ui_hud_show_crosshair", _ref.check_box(true),
		function (group, name, value)
			if not this.crosshair_ready then
				return
			end
			run_console("hud_crosshair", value)
		end
	)

	_ref.register_option("st_ui_group_crosshair", "switch_to_crosshair_point_mode", "st_ui_hud_use_crosshair_point_mode",
		_ref.check_box(false),
		function (group, name, value)
			run_console("hud_crosshair_point", value)
		end
	)

	_ref.register_option("st_ui_group_crosshair", "show_crosshair_target_distance", "st_ui_hud_show_crosshair_target_distance",
		_ref.check_box(false),
		function (group, name, value)
			run_console("hud_crosshair_dist", value)
		end
	)
end

function on_game_start()
	this.navigation_mode = read_boot_use_compass_bar() and this.MODE_COMPASS or this.MODE_MINIMAP
	this.inventory_sort_system = read_boot_inventory_sort_system()
	this.inventory_volume_enabled = read_boot_inventory_volume()

	RegisterScriptCallback("main_menu_on_init", on_main_menu_ready)
	RegisterScriptCallback("actor_on_first_update", on_actor_hud_ready)
	RegisterScriptCallback("on_init_ixr_options", register_options)
end
