[encyclopedia_catalog]
sections    = zone, mechanics, factions, locations, weapons, attachments, ammo, explosives, outfits, helmets, artefacts, medicine, devices, equipment, misc, mutants, anomalies
color_label = 255,140,140,140
color_value = 255,220,220,220
color_good  = 255,110,210,110
color_bad   = 255,225,95,85

[encyclopedia_section.zone]
caption = pda_ref_grp_zone
source  = articles
unlock  = always
list    = zone_intro, emission, anomalies_intro

[encyclopedia_section.mechanics]
caption = pda_enc_grp_mechanics
source  = list
unlock  = always
list    = mech_radiation, mech_bleeding, mech_psy, mech_hunger, mech_stamina, mech_weight, mech_belt, mech_detectors, mech_upgrades, mech_trade, mech_sleep, mech_stashes, mech_relations

[encyclopedia_section.factions]
caption = pda_enc_grp_factions
source  = list
unlock  = always
list    = fac_stalker, fac_dolg, fac_freedom, fac_bandit, fac_killer, fac_army, fac_ecolog, fac_monolith, fac_zombied

[encyclopedia_section.locations]
caption = pda_enc_grp_locations
source  = list
unlock  = always
list    = loc_zaton, loc_jupiter, loc_underpass, loc_pripyat, loc_labx8

[encyclopedia_section.weapons]
caption = pda_ref_grp_weapons
classes = WP_*
exclude = WP_SCOPE, WP_SILEN, WP_GLAUN, WP_KNIFE, WP_BINOC
scheme  = weapon

[encyclopedia_section.attachments]
