<w>
    <main_wnd x="0" y="0" width="1024" height="768" replace_task_list="1">
        <auto_static x="47" y="76" width="76" height="24">
            <text align="l" vert_align="c" font="font_roboto_15" r="55" g="59" b="60">pda_tj_list_caption</text>
        </auto_static>
        <auto_static x="378" y="75" width="400" height="26">
            <text align="l" vert_align="c" font="font_roboto_15" r="55" g="59" b="60">pda_tj_details_caption</text>
        </auto_static>
    </main_wnd>

    <filter_tabs x="90" y="103" width="240" height="24" counters="0">
        <button x="0" y="0" width="80" height="24" id="active" frame_mode="1">
            <texture_e>ui_RP2_pda_tab_btn_e</texture_e>
            <texture_h>ui_RP2_pda_tab_btn_h</texture_h>
            <texture_t>ui_RP2_pda_tab_btn_t</texture_t>
            <texture_d>ui_RP2_pda_tab_btn_d</texture_d>
            <text align="c" vert_align="c" x="0" y="0" font="font_roboto_15">pda_tj_filter_active</text>
            <text_color>
                <e r="193" g="201" b="209" a="140"/>
                <t r="215" g="205" b="90" a="255"/>
                <d r="122" g="135" b="148" a="255"/>
                <h r="160" g="175" b="190" a="255"/>
            </text_color>
        </button>
        <button x="65" y="0" width="80" height="24" id="completed" frame_mode="1">
            <texture_e>ui_RP2_pda_tab_btn_e</texture_e>
            <texture_h>ui_RP2_pda_tab_btn_h</texture_h>
            <texture_t>ui_RP2_pda_tab_btn_t</texture_t>
            <texture_d>ui_RP2_pda_tab_btn_d</texture_d>
            <text align="c" vert_align="c" x="0" y="0" font="font_roboto_15">pda_tj_filter_completed</text>
            <text_color>
                <e r="193" g="201" b="209" a="140"/>
                <t r="215" g="205" b="90" a="255"/>
                <d r="122" g="135" b="148" a="255"/>
                <h r="160" g="175" b="190" a="255"/>
            </text_color>
        </button>
        <button x="130" y="0" width="80" height="24" id="failed" frame_mode="1">
            <texture_e>ui_RP2_pda_tab_btn_e</texture_e>
            <texture_h>ui_RP2_pda_tab_btn_h</texture_h>
            <texture_t>ui_RP2_pda_tab_btn_t</texture_t>
            <texture_d>ui_RP2_pda_tab_btn_d</texture_d>
            <text align="c" vert_align="c" x="0" y="0" font="font_roboto_15">pda_tj_filter_failed</text>
            <text_color>
                <e r="193" g="201" b="209" a="140"/>
                <t r="215" g="205" b="90" a="255"/>
                <d r="122" g="135" b="148" a="255"/>
                <h r="160" g="175" b="190" a="255"/>
            </text_color>
        </button>
    </filter_tabs>

    <filter_hint_prev x="42.000" y="105.000" width="22" height="22" chips_align="l" style="pda_small">
        <item action="pda_task_journal_filter_prev" gamepad_action="pda_task_journal_filter_prev"/>
    </filter_hint_prev>
    <filter_hint_next x="337" y="105.000" width="22" height="22" chips_align="l" style="pda_small">
        <item action="pda_task_journal_filter_next" gamepad_action="pda_task_journal_filter_next"/>
    </filter_hint_next>

    <task_list x="39" y="130" width="318" height="565" top_indent="2" vert_interval="2"
        scroll_profile="pda_logs" always_show_scroll="1"/>

    <group_header x="0" y="0" width="300" height="20" text_story="pda_tj_group_story" text_side="pda_tj_group_side">
        <text x="8" align="l" vert_align="c" font="font_rubik_12" r="110" g="110" b="110"/>
    </group_header>

    <task_item x="0" y="0" width="300" height="35" padding="10">
        <selection type="line" x="0" y="0" width="310" height="35">
            <texture a="255">ui_RP2_chips</texture>
        </selection>
        <active_mark x="0" y="0" width="29" height="38" stretch="1">
            <texture r="255" g="150" b="0">ui_inGame2_PDA_icon_NewQuest_white</texture>
        </active_mark>
        <icon x="-4000" y="-8000" width="22" height="22" stretch="1"/>
        <title x="32" y="11" width="216" height="16">
            <text align="l" font="font_rubik_14" r="210" g="210" b="210"/>
        </title>
        <status x="180" y="11" width="90" height="16" text_completed="pda_tj_item_completed" text_failed="pda_tj_item_failed">
            <text align="r" font="font_rubik_12" r="150" g="150" b="150"/>
        </status>
        <btn_focus x="292" y="11" width="14" height="17" hint="ui_task_btn_focus_center" stretch="1">
            <texture_e>ui_RP2_IconFocus</texture_e>
            <texture_t>ui_RP2_IconFocus</texture_t>
            <texture_h>ui_RP2_IconFocus</texture_h>
            <texture_d>ui_RP2_IconFocus</texture_d>
        </btn_focus>
        <colors>
            <normal r="210" g="210" b="210"/>
            <active r="235" g="215" b="140"/>
            <unread r="245" g="245" b="245"/>
            <completed r="130" g="190" b="120"/>
            <failed r="205" g="115" b="95"/>
        </colors>
    </task_item>

    <t_empty x="49" y="130" width="290" height="40" complex_mode="1"
        text_active="pda_tj_empty_active" text_completed="pda_tj_empty_completed" text_failed="pda_tj_empty_failed">
        <text align="l" font="font_rubik_14" r="120" g="120" b="120"/>
    </t_empty>

    <details x="366" y="117" width="635" height="580"
        heading_source="description"
        image_level_intro="1" image_default="intro\intro_no_start_picture"
        received_format="pda_tj_received" finished_format="pda_tj_finished" location_format="pda_tj_location"
        objectives_caption="pda_tj_objectives">
        <empty x="14" y="12" width="600" height="20">
            <text align="l" font="font_rubik_14" r="120" g="120" b="120">pda_tj_select_task</text>
        </empty>
        <image x="3.000" y="-3.000" width="633" height="225.000" stretch="1"/>
        <body x="0" y="194" width="635" height="316" vert_interval="4" top_indent="2"
            scroll_profile="pda_logs" always_show_scroll="0"/>

        <btn_map x="8" y="518" width="300" height="26">
            <text x="32" align="l" vert_align="c" font="font_rubik_14" r="200" g="200" b="200">pda_tj_show_on_map</text>
            <hint x="0" y="1" width="26" height="24" chips_align="l" style="pda">
                <item action="pda_task_journal_show_on_map" gamepad_action="pda_task_journal_show_on_map"/>
            </hint>
        </btn_map>
        <btn_activate x="8" y="550" width="300" height="26">
            <text x="32" align="l" vert_align="c" font="font_rubik_14" r="200" g="200" b="200">pda_tj_set_active</text>
            <hint x="0" y="1" width="26" height="24" chips_align="l" style="pda">
                <item action="pda_task_journal_track" gamepad_action="pda_task_journal_track"/>
            </hint>
        </btn_activate>

        <heading x="3" y="0" width="615" height="24" complex_mode="1">
            <text align="l" font="font_roboto_25" r="215" g="215" b="215"/>
        </heading>
        <descr x="3" y="0" width="615" height="16" complex_mode="1">
            <text align="l" font="font_roboto_16" r="190" g="190" b="190"/>
        </descr>
        <info x="3" y="0" width="615" height="16">
            <text align="l" font="font_roboto_16" r="140" g="140" b="140"/>
        </info>
        <objectives_caption x="0" y="0" width="615" height="26">
            <text align="l" vert_align="b" font="font_oswald_20" r="200" g="200" b="200"/>
        </objectives_caption>
        <objective x="12" y="0" width="600" height="16" complex_mode="1">
            <text align="l" font="font_rubik_14" r="200" g="200" b="200"/>
        </objective>
        <colors>
            <progress r="200" g="200" b="200"/>
            <completed r="130" g="190" b="120"/>
            <failed r="205" g="115" b="95"/>
        </colors>
    </details>
</w>
