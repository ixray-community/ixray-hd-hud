<scroll_bar>
	<default height="6" height_v="6" hold_delay="40" layout="stretch">
		<back_v width="6" height="128">
			<texture>ui_RenewedPerception_scroll_v_track</texture>
		</back_v>
		<box_v frame_mode="0" vertical="1" width="4" height="64">
			<texture>ui_RenewedPerception_scroll_v_thumb</texture>
		</box_v>
		<back width="128" height="6">
			<texture>ui_RenewedPerception_scroll_h_track</texture>
		</back>
		<box frame_mode="0" vertical="0" width="64" height="4">
			<texture>ui_RenewedPerception_scroll_h_thumb</texture>
		</box>
	</default>

	<!-- PDA map: stretch (UIMapWnd passes axis length); same parts as default -->
	<pda height="6" height_v="6" hold_delay="40" layout="stretch" thumb="box">
		<back_v width="6" height="128">
			<texture>ui_RenewedPerception_scroll_v_track</texture>
		</back_v>
		<box_v frame_mode="0" vertical="1" width="4" height="64">
			<texture>ui_RenewedPerception_scroll_v_thumb</texture>
		</box_v>
		<back width="128" height="6">
			<texture>ui_RenewedPerception_scroll_h_track</texture>
		</back>
		<box frame_mode="0" vertical="0" width="64" height="4">
			<texture>ui_RenewedPerception_scroll_h_thumb</texture>
		</box>
	</pda>

	<pda_logs height_v="6" hold_delay="40" layout="stretch" thumb="box">
		<back_v width="6" height="128">
			<texture>ui_RenewedPerception_scroll_v_track</texture>
		</back_v>
		<box_v frame_mode="0" vertical="1" width="4" height="64">
			<texture>ui_RenewedPerception_scroll_v_thumb</texture>
		</box_v>
	</pda_logs>

	<renewed_perception height="6" height_v="6" hold_delay="40" layout="stretch">
		<back_v width="6" height="128">
			<texture>ui_RenewedPerception_scroll_v_track</texture>
		</back_v>
		<box_v frame_mode="0" vertical="1" width="4" height="64">
			<texture>ui_RenewedPerception_scroll_v_thumb</texture>
		</box_v>
		<back width="128" height="6">
			<texture>ui_RenewedPerception_scroll_h_track</texture>
		</back>
		<box frame_mode="0" vertical="0" width="64" height="4">
			<texture>ui_RenewedPerception_scroll_h_thumb</texture>
		</box>
	</renewed_perception>
</scroll_bar>
