<?xml version='1.0' encoding="UTF-8"?>
<window>

	<main_wnd x="0" y="0" width="1024" height="768"/>

	<background x="35" y="41" width="955" height="667">
        <texture>ui_inGame2_pda_buttons_background</texture>
	</background>

    <left_frame_window x="7" y="50" width="633" height="600" a="80">
		<texture>ui_inGame2_pda_ranking_icon_over</texture>
    </left_frame_window>

    <left_frame_line x="8" y="17" width="606" height="21">
        <title x="10" y="1" width="435" height="18">
            <text font="letterica16" r="100" g="100" b="100">Contacts</text>
        </title>
        <texture>ui_inGame2_pda_ranking_center_caption</texture>
    </left_frame_line>

    <right_frame_window x="650" y="50" width="298" height="600" a="80">
		<texture>ui_inGame2_pda_ranking_icon_over</texture>
    </right_frame_window>

    <right_frame_line x="8" y="17" width="284" height="21">
        <title x="10" y="1" width="260" height="18">
            <text font="letterica16" r="100" g="100" b="100">PDA Dialogue</text>
        </title>
        <texture>ui_inGame2_pda_ranking_center_caption</texture>
    </right_frame_line>

	<list x="15" y="48" width="616" height="550" scroll_style="rp" always_show_scroll="1" can_select="1"/>
	<detail_list x="20" y="48" width="272" height="550" scroll_style="rp" always_show_scroll="1" left_ident="5"/>

	<!-- PDA dialog is positioned inside right_frame_window by this local root. -->
	<pda_dialog>
		<main x="0" y="0" width="298" height="600"/>

		<gamepad_legend x="0" y="564" width="298" height="32" spacing="4">
			<auto_static x="0" y="0" width="22" height="32">
				<text font="letterica18" vert_align="c">ui_talk_reply</text>
			</auto_static>
			<auto_static x="0" y="0" width="22" height="32">
				<window_name>log_hint</window_name>
				<text font="letterica18" vert_align="c">ui_talk_log</text>
			</auto_static>
			<auto_static x="0" y="0" width="22" height="32">
				<window_name>trade_hint</window_name>
				<text font="letterica18" vert_align="c">ui_talk_open_trade</text>
			</auto_static>
			<auto_static x="0" y="0" width="22" height="32">
				<window_name>back_hint</window_name>
				<text font="letterica18" vert_align="c">ui_mm_back_gp</text>
			</auto_static>
		</gamepad_legend>

		<button x="8" y="528" width="282" height="28" stretch="1" hint="ui_st_exit_hint">
			<texture>ui_inGame2_big_inventory_button</texture>
			<text font="graffiti22" align="c">ui_st_trade</text>
			<text_color>
				<e color="ui_6"/>
				<t color="ui_black"/>
				<d color="ui_5"/>
				<h color="ui_black"/>
			</text_color>
		</button>

		<answers_list x="8" y="40" width="282" height="345" scroll_style="rp" always_show_scroll="1" left_ident="4"/>
		<questions_list x="8" y="397" width="282" height="119" scroll_style="rp" always_show_scroll="1" left_ident="4"/>

		<font font="letterica18" r="210" g="215" b="225"/>
		<font font="letterica18" r="200" g="200" b="200"/>

		<question_item width="270" height="22" min_height="13">
			<num_text x="0" y="3" width="10" height="22">
				<text font="letterica18" color="ui_2"/>
			</num_text>
			<content_text x="18" y="3" width="246" height="22" offset="3">
				<text font="letterica18" color="ui_2" align="l" complex_mode="1"/>
				<text_color>
					<t r="231" g="168" b="12"/>
					<e color="ui_2"/>
					<h color="ui_7"/>
				</text_color>
			</content_text>
		</question_item>

		<other_answer_item width="270" height="0" min_height="13" bottom_footer="5">
			<name_caption x="0" y="3" width="262" height="10">
				<text font="graffiti22" color="ui_7" complex_mode="0"/>
			</name_caption>
			<content_text x="18" y="22" width="246" height="10" complex_mode="1">
				<text font="letterica18" color="ui_8"/>
			</content_text>
		</other_answer_item>

		<actor_answer_item x="0" y="0" width="270" height="0" min_height="13" bottom_footer="10">
			<name_caption x="0" y="3" width="262" height="10">
				<text font="graffiti22" color="ui_lime" complex_mode="0"/>
			</name_caption>
			<content_text x="18" y="22" width="246" height="10" complex_mode="1">
				<text font="letterica18" color="ui_2"/>
			</content_text>
		</actor_answer_item>

		<iconed_answer_item x="0" y="0" width="270" height="0" min_height="30" bottom_footer="5">
			<name_caption x="0" y="0" width="0" height="0"/>
			<content_text x="58" y="0" width="206" height="29" complex_mode="1">
				<text font="letterica18" color="ui_1"/>
			</content_text>
			<msg_icon x="18" y="3" width="44" height="29"/>
		</iconed_answer_item>

		<simple_answer_item x="0" y="0" width="270" height="0" min_height="13" bottom_footer="5">
			<name_caption x="0" y="0" width="0" height="0"/>
			<content_text x="46" y="0" width="218" height="29" complex_mode="1">
				<text font="letterica18" color="ui_1"/>
			</content_text>
			<msg_icon x="18" y="3" width="0" height="0"/>
		</simple_answer_item>

		<iconed_trade_info x="0" y="0" width="270" height="0" min_height="20" bottom_footer="5">
			<name_caption x="0" y="0" width="0" height="0"/>
			<content_text x="50" y="2" width="214" height="20" complex_mode="1">
				<text font="letterica18" color="ui_8"/>
			</content_text>
			<msg_icon x="18" y="0" width="30" height="20"/>
		</iconed_trade_info>
	</pda_dialog>

	<right_auto_static x="20" y="560" width="260" height="24">
		<text align="l" font="letterica16" r="130" g="130" b="130"></text>
	</right_auto_static>

    <a_static x="395" y="-3" width="32" height="32" frames="16" duration="1000" columns="8" frame_width="32" frame_height="32" cyclic="1" autoplay="1">
        <texture></texture>
    </a_static>
</window>
