<w>
    <main_wnd x="0" y="0" width="1024" height="768" update_delay="2500"/>

    <center_caption x="55" y="157" width="650" height="16">
        <text align="l" font="letterica16" r="100" g="100" b="100" a="0"/>
    </center_caption>

    <logs_list_news x="35" y="122" width="280" height="605" item_height="35" top_indent="36"
        scroll_profile="pda_logs" always_show_scroll="1">
        <font font="letterica18" color="ui_4"/>
        <auto_frameline x="0" y="0" width="275" height="30" vertical="0">
            <title x="15" y="4" width="255" height="20">
                <text font="font_oswald_24" r="170" g="170" b="170" a="255" align="l">pda_log_journal_events</text>
            </title>
            <texture a="128">ui_inGame2_pda_background_text</texture>
        </auto_frameline>
        <logs_item x="0" y="0" width="260" height="38">
            <date_static x="55" y="1" width="100" height="14">
                <text align="l" font="letterica16" color="ui_3"/>
            </date_static>
            <caption_static x="150" y="1" width="750" height="14">
                <text align="l" font="letterica16" color="ui_1"/>
            </caption_static>
            <text_static x="55" y="16" width="218" height="14" complex_mode="1">
                <text align="l" font="letterica16" color="ui_4"/>
            </text_static>
            <image x="5" y="0" width="40" height="29" stretch="1"/>
        </logs_item>
    </logs_list_news>

    <logs_list_dialogs x="320" y="122" width="680" height="605" item_height="35" top_indent="36"
        scroll_profile="pda_logs" always_show_scroll="1">
        <font font="letterica18" color="ui_4"/>
        <auto_frameline x="0" y="0" width="675" height="30" vertical="0">
            <title x="580" y="4" width="595" height="20">
                <text font="font_oswald_24" r="170" g="170" b="170" a="255" align="l">pda_log_journal_dialogs</text>
            </title>
            <texture a="128">ui_inGame2_pda_background_text</texture>
        </auto_frameline>

        <btn_talk_sort_oldest x="3" y="3" width="20" height="24" stretch="1" hint="pda_log_sort_oldest_hint">
            <texture>ui_inGame2_pda_sort_oldest</texture>
        </btn_talk_sort_oldest>

        <btn_talk_sort_newest x="25" y="3" width="20" height="24" stretch="1" hint="pda_log_sort_newest_hint">
            <texture>ui_inGame2_pda_sort_newest</texture>
        </btn_talk_sort_newest>

        <btn_talk_pin_last x="47" y="3" width="20" height="24" stretch="1" hint="pda_log_pin_last_hint">
            <texture>ui_inGame2_pda_log_pin_last</texture>
        </btn_talk_pin_last>

        <logs_item x="0" y="0" width="672" height="38">
            <date_static x="55" y="1" width="100" height="14">
                <text align="l" font="letterica16" color="ui_3"/>
            </date_static>
            <caption_static x="150" y="1" width="750" height="14">
                <text align="l" font="letterica16" color="ui_1"/>
            </caption_static>
            <text_static x="55" y="16" width="610" height="14" complex_mode="1">
                <text align="l" font="letterica16" color="ui_4"/>
            </text_static>
            <image x="5" y="0" width="40" height="29" stretch="1"/>
        </logs_item>
    </logs_list_dialogs>

    <period_caption x="525" y="85" width="80" height="23">
        <text align="r" vert_align="c" font="letterica18" r="220" g="220" b="220">pda_date_filter</text>
    </period_caption>
    <period x="820" y="79" width="120" height="40" stretch="1">
        <text align="c" vert_align="c" font="letterica18" r="170" g="170" b="170"/>
    </period>

    <btn_prev_period x="789" y="79" width="30" height="37" stretch="1">
        <window_name>btn_prev_period</window_name>
        <texture>ui_inGame2_pda_Filtr_arrow_left</texture>
    </btn_prev_period>

    <btn_calendar x="940" y="79" width="30" height="37" stretch="1">
        <window_name>btn_calendar</window_name>
        <texture>ui_pda_cal_btn</texture>
    </btn_calendar>

    <btn_next_period x="970" y="79" width="30" height="37" stretch="1">
        <window_name>btn_next_period</window_name>
        <texture>ui_inGame2_pda_Filtr_arrow_right</texture>
    </btn_next_period>

    <calendar_popup x="767" y="120" width="205" height="228" anchor_gap="4" anchor_to_btn="0" free_month_nav="1" free_month_year_min="1986" free_month_year_max="2099">
        <background x="0" y="0" width="205" height="228" stretch="1">
            <texture>ui_inGame2_pda_cal_popup</texture>
        </background>

        <month_stepper x="8" y="8" width="189" height="37">
            <btn_prev_month x="0" y="0" width="30" height="37">
                <texture>ui_inGame2_pda_Filtr_arrow_left</texture>
            </btn_prev_month>
            <month_caption x="41" y="0" width="107" height="37">
                <text align="c" vert_align="c" font="letterica16" r="220" g="220" b="220"/>
            </month_caption>
            <btn_next_month x="152" y="0" width="30" height="37">
                <texture>ui_inGame2_pda_Filtr_arrow_right</texture>
            </btn_next_month>
        </month_stepper>

        <weekdays_row x="16" y="50" width="173" height="16">
            <auto_static x="0" y="0" width="23" height="16"><text align="c" font="letterica16" r="140" g="140" b="140">Пн</text></auto_static>
            <auto_static x="25" y="0" width="23" height="16"><text align="c" font="letterica16" r="140" g="140" b="140">Вт</text></auto_static>
            <auto_static x="50" y="0" width="23" height="16"><text align="c" font="letterica16" r="140" g="140" b="140">Ср</text></auto_static>
            <auto_static x="75" y="0" width="23" height="16"><text align="c" font="letterica16" r="140" g="140" b="140">Чт</text></auto_static>
            <auto_static x="100" y="0" width="23" height="16"><text align="c" font="letterica16" r="140" g="140" b="140">Пт</text></auto_static>
            <auto_static x="125" y="0" width="23" height="16"><text align="c" font="letterica16" r="140" g="140" b="140">Сб</text></auto_static>
            <auto_static x="150" y="0" width="23" height="16"><text align="c" font="letterica16" r="140" g="140" b="140">Вс</text></auto_static>
        </weekdays_row>
        <days_host x="16" y="68" width="173" height="148" columns="7" rows="6" cell_size="23" spacing="2" cell_texture="ui_pda_cal_day"/>
    </calendar_popup>
</w>
