<window>
	<compass_bar
		alignment="c"
		fade_in_speed="5"
		fade_out_speed="4"
		fov_angle="165"
		x="0.5" y="0.09"
		width="0.5" height="0.04" stretch="1"
		override="replace">

		<style_sheet>
			<shadows thickness="0.5" r="0" g="0" b="0" a="100"/>
		</style_sheet>

		<background x="0" y="-0.85" width="0.9" height="0.9" alignment="l" stretch="1">
			<draw>
				<texture a="200">ui_inGame2_compass_bar_window</texture>
			</draw>
		</background>

		<dial
			x="0.42" y="-0.35"
			width="0.95" height="1.0"
			circumference_px="1024"
			loop="1"
			heading_bias_deg="180"
			alignment="c"
			stretch="1">
			<draw>
				<texture
					x="0"
					y="-0.0326"
					width="0.8"
					height="0.15"
					stretch="1"
					a="255">ui_inGame2_compass_dial</texture>
			</draw>
		</dial>

		<cardinals alignment="c" x="0" y="0.25" width="0.065" height="0.4" stretch="1">
			<main show="false">
				<text align="c" font="font_blender_pro_b_14" vert_align="c" stretch="1" r="211" g="211" b="211">
					<shadows thickness="0.5" r="0" g="0" b="0" a="100"/>
				</text>
				<point id="n" text="N" r="227" g="79" b="56"/>
				<point id="e" text="E" align="r"/>
				<point id="s" text="S"/>
				<point id="w" text="W" align="l"/>
			</main>
			<intermediate show="false">
				<text align="c" font="font_blender_pro_b_14" vert_align="c" stretch="1" r="211" g="211" b="211">
					<shadows thickness="0.5" r="0" g="0" b="0" a="100"/>
				</text>
				<point id="ne" text="NE"/>
				<point id="se" text="SE"/>
				<point id="sw" text="SW"/>
				<point id="nw" text="NW"/>
			</intermediate>
			<degrees show="true" step="30" y="0.25">
				<text align="c" font="font_blender_pro_b_14" vert_align="c" stretch="1" r="220" g="220" b="220">
					<shadows thickness="0.5" r="0" g="0" b="0" a="100"/>
				</text>
			</degrees>
			<tick size="0.188 0.339" offset_y="-0.339" stretch="1" texture=""/>
		</cardinals>

		<spots align="c" show="1" stretch="1" x="0" y="-0.65" width="0.5" height="0.4">
			<defaults size="0.078 0.868">
				<shadows thickness="0.5" r="0" g="0" b="0" a="100"/>
			</defaults>
		</spots>

		<active_target x="0" y="-0.41" width="0.0195" height="0.716" padding="0.0195" smoothing="10" altitude_deadzone="1.8">
			<altitude_arrow show="true" x="-0.0039" y="-0.01" width="0.0117" height="0.0156">
				<draw stretch="1"
					texture_up="ui_inGame2_compass_altitude_up"
					texture_down="ui_inGame2_compass_altitude_down">
					<shadows thickness="0.5" r="0" g="0" b="0" a="100"/>
				</draw>
			</altitude_arrow>
			<marker show="true" x="0" y="0" width="0.0391" height="0.0521">
				<draw>
					<texture stretch="1">ui_inGame2_hint_wnd_main_window</texture>
					<shadows thickness="0.5" r="0" g="0" b="0" a="100"/>
				</draw>
			</marker>
			<distance_text show="true" x="0.0068" y="-0.01" width="0.0781" height="0.0182" align="l" vert_align="c">
				<text align="l" font="font_rubik_bold_12" vert_align="c">
					<shadows thickness="0.5" r="0" g="0" b="0" a="100"/>
				</text>
			</distance_text>
		</active_target>
	</compass_bar>
</window>
