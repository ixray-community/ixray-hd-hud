<?xml version="1.0" encoding="UTF-8"?>
<!-- CUITalkDialogWnd (embedded PDA): must include answers_list, questions_list, button, font x2, question_item, answer items (see talk.xml). -->
<w>
	<main x="0" y="0" width="335" height="560"/>

	<gamepad_legend x="0" y="524" width="335" height="32" spacing="4">
		<auto_static x="0" y="0" width="22" height="32">
			<text font="letterica18" vert_align="c">ui_talk_reply</text>
		</auto_static>
		<auto_static x="0" y="0" width="22" height="32">
			<window_name>log_hint</window_name>
			<text font="letterica18" vert_align="c">ui_talk_log</text>
		</auto_static>
		<auto_static x="0" y="0" width="22" height="32">
			<window_name>trade_hint</window_name>
			<text font="letterica18" vert_align="c">ui_talk_open_trade</text>
		</auto_static>
		<auto_static x="0" y="0" width="22" height="32">
			<window_name>back_hint</window_name>
			<text font="letterica18" vert_align="c">ui_mm_back_gp</text>
		</auto_static>
	</gamepad_legend>

	<button x="10" y="488" width="315" height="28" stretch="1" hint="ui_st_exit_hint">
		<texture>ui_inGame2_big_inventory_button</texture>
		<text font="graffiti22" align="c">ui_st_trade</text>
		<text_color>
			<e color="ui_6"/>
			<t color="ui_black"/>
			<d color="ui_5"/>
			<h color="ui_black"/>
		</text_color>
	</button>

	<answers_list x="10" y="40" width="315" height="320" always_show_scroll="1" left_ident="4"/>
	<questions_list x="10" y="372" width="315" height="104" always_show_scroll="1" left_ident="4"/>

	<font font="letterica18" r="210" g="215" b="225"/>
	<font font="letterica18" r="200" g="200" b="200"/>

	<question_item width="303" height="22" min_height="13">
		<num_text x="0" y="3" width="10" height="22">
			<text font="letterica18" color="ui_2"/>
		</num_text>
		<content_text x="18" y="3" width="278" height="22" offset="3">
			<text font="letterica18" color="ui_2" align="l" complex_mode="1"/>
			<text_color>
				<t r="231" g="168" b="12"/>
				<e color="ui_2"/>
				<h color="ui_7"/>
			</text_color>
		</content_text>
	</question_item>

	<other_answer_item width="303" height="0" min_height="13" bottom_footer="5">
		<name_caption x="0" y="3" width="295" height="10">
			<text font="graffiti22" color="ui_7" complex_mode="0"/>
		</name_caption>
		<content_text x="18" y="22" width="278" height="10" complex_mode="1">
			<text font="letterica18" color="ui_8"/>
		</content_text>
	</other_answer_item>

	<actor_answer_item x="0" y="0" width="303" height="0" min_height="13" bottom_footer="10">
		<name_caption x="0" y="3" width="295" height="10">
			<text font="graffiti22" color="ui_lime" complex_mode="0"/>
		</name_caption>
		<content_text x="18" y="22" width="278" height="10" complex_mode="1">
			<text font="letterica18" color="ui_2"/>
		</content_text>
	</actor_answer_item>

	<iconed_answer_item x="0" y="0" width="303" height="0" min_height="30" bottom_footer="5">
		<name_caption x="0" y="0" width="0" height="0"/>
		<content_text x="58" y="0" width="238" height="29" complex_mode="1">
			<text font="letterica18" color="ui_1"/>
		</content_text>
		<msg_icon x="18" y="3" width="44" height="29"/>
	</iconed_answer_item>

	<simple_answer_item x="0" y="0" width="303" height="0" min_height="13" bottom_footer="5">
		<name_caption x="0" y="0" width="0" height="0"/>
		<content_text x="46" y="0" width="248" height="29" complex_mode="1">
			<text font="letterica18" color="ui_1"/>
		</content_text>
		<msg_icon x="18" y="3" width="0" height="0"/>
	</simple_answer_item>

	<iconed_trade_info x="0" y="0" width="303" height="0" min_height="20" bottom_footer="5">
		<name_caption x="0" y="0" width="0" height="0"/>
		<content_text x="50" y="2" width="248" height="20" complex_mode="1">
			<text font="letterica18" color="ui_8"/>
		</content_text>
		<msg_icon x="18" y="0" width="30" height="20"/>
	</iconed_trade_info>
</w>
