<window>
    <compass_bar
        alignment="c"
        fov_angle="45"
        height="0.045"
        width="0.52"
        x="0.5"
        y="0.060"
    >
        <background
            alignment="c"
            height="0.5"
            width="0.6"
            stretch="1"
            x="0"
            y="-0.625"
        >
            <texture>ui_inGame2_compass_bar_window</texture>
        </background>

        <strip
            height="5"
            stretch="1"
            tex_loop="1"
            tex_width="1024"
            units="relative"
            width="0.89"
            x="0.050"
            y="-1.5"
        >
            <texture height="1" width="1" height_px="5" offset_x="0" offset_y="-6">ui_inGame2_compass_dial</texture>

            <cardinal_points
                alignment="c"
                height="0.28"
                units="relative"
                width="0.065"
                y="0.25"
                stretch="1"
            >
                <text align="c" font="font_blender_pro_b_14" vert_align="c" stretch="1"/>
                <main_cardinals>
                    <text align="c" font="font_blender_pro_b_14" color="ui_1" vert_align="c" stretch="1" />
                    <n>N</n>
                    <e align="r">E</e>
                    <s>S</s>
                    <w align="l">W</w>
                </main_cardinals>
                <inter_cardinals>
                    <text align="c" font="font_blender_pro_b_12" color="ui_1" vert_align="c" stretch="1" />
                    <ne>NE</ne>
                    <se>SE</se>
                    <sw>SW</sw>
                    <nw>NW</nw>
                </inter_cardinals>
            </cardinal_points>
        </strip>

        <spots
            align="c"
            collect_interval="0.1"
            show="1"
            x="0"
            y="0"
            stretch="1"
        >
            <spot_template height="8" width="8" stretch="1"/>
            <spot_types>
                <default offset_x="0" offset_y="-20" valign="center" stretch="1"/>
            </spot_types>
        </spots>

        <active_target
            height="22"
            offset_y="-20"
            padding="8"
            smoothing_speed="10"
            width="10"
            stretch="1"
        >
            <marker
                height="20"
                texture="ui_inGame2_hint_wnd_main_window"
                width="20"
                x="0"
                y="-5"
                stretch="1"
            />
            <distance_text
                align="l"
                color="ui_1"
                height="14"
                vert_align="c"
                width="80"
                x="-3"
                y="-20"
            >
                <text align="l" font="font_rubik_12" vert_align="c"/>
            </distance_text>
        </active_target>
    </compass_bar>
</window>