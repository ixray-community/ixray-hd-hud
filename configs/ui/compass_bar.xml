<window>
	<compass_bar x="512" y="45" width="420" height="55" alignment="c" fov_angle="45">
		<background x="0" y="40" width="400" height="55" stretch="1" alignment="r">
			<texture>ui_inGame2_compass_bar_window</texture>
		</background>
		<compass_dial>
			<strip x="20" y="10" width="380" height="25" stretch="1" tex_width="1024" tex_loop="1">
				<texture>ui_inGame2_compass_dial</texture>
			</strip>
			<cardinal_points y="5" width="10" height="10" alignment="c" label_mode="cardinals">
				<text font="font_rubik_14" color="ui_1" align="c" vert_align="c"/>
				<n>N</n>
				<e align="r">E</e>
				<s >S</s>
				<w align="l">W</w>
				<ne>ne</ne>
				<se>se</se>
				<sw>sw</sw>
				<nw>nw</nw>
			</cardinal_points>
		</compass_dial>
		<spots show="1" x="0" y="0" align="c" collect_interval="0.1">
			<spot_template width="8" height="11"/>
		</spots>
		<active_target strip_y="0" markers_y="-2" dist_y="-5" smoothing_speed="10" active_target_padding="8" offset_x="0" offset_y="0" text_offset_x="38" text_offset_y="10">
			<distance_text width="80" height="14" alignment="c">
				<text font="font_rubik_12" color="ui_1" align="c" vert_align="c"/>
			</distance_text>
			<marker width="12" height="15" stretch="1">
				<texture>ui_inGame2_hint_wnd_main_window</texture>
			</marker>
		</active_target>
	</compass_bar>
</window>