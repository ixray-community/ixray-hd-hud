	<map_wnd scroll_enable="1" map_move_step="11" override="replace">
		<main_wnd x="0" y="150" width="1024" height="618"/>

		<main_map_frame x="0" y="0" width="1024" height="618" dx="0" dy="0" sx="6" sy="6">
			<texture>ui_pda2_mapframe</texture>
		</main_map_frame>

		<level_frame x="0" y="0" width="1024" height="618"/>

		<map_hint_item x="0" y="0" width="250" height="200" stretch="1">
			<texture>ui_icons_PDA_tooltips</texture>

			<simple_text x="7" y="12" width="154" height="192" complex_mode="1">
				<text align="l" font="letterica18"/>
			</simple_text>

			<t_icon x="9" y="11" width="35" height="37" stretch="1"/>

			<t_caption x="54" y="12" width="175" height="18" complex_mode="1">
				<text align="l" font="letterica18"/>
			</t_caption>

			<t_time x="54" y="38" width="175" height="18">
				<text align="l" font="letterica16" color="ui_9"/>
			</t_time>

			<t_time_rem x="54" y="58" width="175" height="18" _light_anim="ui_too_slow_blinking" la_cyclic="1" la_texture="0" la_text="1" la_alpha="1">
				<text align="l" font="letterica16" color="ui_9"/>
			</t_time_rem>

			<t_hint_text x="7" y="75" width="229" height="18" complex_mode="1">
