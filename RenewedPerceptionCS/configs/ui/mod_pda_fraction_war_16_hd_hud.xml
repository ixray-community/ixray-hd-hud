        </background>
    </progress_enemy_mem_count>

    <progress_our_resource x="45" y="540" width="455" height="38" min="0" max="100" pos="0" mode="horz" override="replace">
        <progress stretch="1">
            <texture color="pda_blue">ui_pda2_small_progress</texture>
        </progress>
        <background stretch="1">
            <texture a="60">ui_pda2_small_progress</texture>
        </background>
    </progress_our_resource>
    <progress_enemy_resource x="524" y="540" width="455" height="38" min="0" max="100" pos="0" mode="back" override="replace">
        <progress stretch="1">
            <texture color="pda_blue">ui_pda2_small_progress</texture>
        </progress>
        <background stretch="1">
            <texture a="60">ui_pda2_small_progress</texture>
        </background>
    </progress_enemy_resource>
</w>
