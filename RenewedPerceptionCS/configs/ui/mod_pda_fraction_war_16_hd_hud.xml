<w>
    <main_wnd x="0" y="0" width="1024" height="768" update_delay="2900" stretch="1" override="replace"/>

    <background x="0" y="48" width="1024" height="720" vertical="1" stretch="1" override="replace">
        <texture>ui_pda2_fr</texture>
    </background>

    <center_background x="0" y="310" width="1024" height="103" stretch="1" override="replace">
        <texture>ui_pda2_fr_delimiter_fraction</texture>
    </center_background>

    <target_static x="332" y="65" width="360" height="16" override="replace">
        <text font="letterica16" align="c" r="250" g="250" b="250" a="100">ui_st_target_static</text>
    </target_static>

    <target_caption x="332" y="90" width="360" height="25" complex_mode="1" override="replace">
        <text font="letterica25" align="c" vert_align="c" r="250" g="250" b="250" a="255">target</text>
    </target_caption>

    <target_decs x="332" y="120" width="360" height="120" override="replace">
        <text font="letterica16" align="c" r="200" g="200" b="200" a="150" complex_mode="1">
        </text>
    </target_decs>

    <state_static x="332" y="250" width="360" height="16" override="replace">
        <text font="letterica16" align="c" vert_align="c" r="250" g="250" b="250" a="100">ui_st_state_confrontation</text>
    </state_static>

    <static_our_icon x="40" y="65" width="225" height="210" stretch="1" override="replace"/>
    <static_enemy_icon x="759" y="65" width="225" height="210" stretch="1" override="replace"/>

    <static_our_icon_over x="40" y="65" width="225" height="210" stretch="1" override="replace">
        <texture>ui_fm_over_fraction_logo_l</texture>
    </static_our_icon_over>
    <static_enemy_icon_over x="759" y="65" width="225" height="210" stretch="1" override="replace">
        <texture>ui_fm_over_fraction_logo_r</texture>
    </static_enemy_icon_over>

    <static_our_name x="40" y="280" width="220" height="25" override="replace">
        <text font="letterica25" align="l" r="250" g="250" b="250" a="255">our name</text>
    </static_our_name>
    <static_enemy_name x="764" y="280" width="220" height="25" override="replace">
        <text font="letterica25" align="r" r="250" g="250" b="250" a="255">enemy name</text>
    </static_enemy_name>

    <static_our_frac_info x="45" y="350" width="180" height="16" override="replace">
        <text font="letterica16" align="l" r="250" g="250" b="250" a="100">ui_st_our_frac_info</text>
    </static_our_frac_info>
    <static_enemy_frac_info x="799" y="350" width="180" height="16" override="replace">
        <text font="letterica16" align="r" r="250" g="250" b="250" a="100">ui_st_enemy_frac_info</text>
    </static_enemy_frac_info>

    <static_our_mem_count x="45" y="425" width="200" height="16" override="replace">
        <text font="letterica16" align="l" r="250" g="250" b="250" a="150">ui_st_our_mem_count</text>
    </static_our_mem_count>
    <static_enemy_mem_count x="779" y="425" width="200" height="16" override="replace">
        <text font="letterica16" align="r" r="250" g="250" b="250" a="150">ui_st_enemy_mem_count</text>
    </static_enemy_mem_count>

    <static_our_resource x="45" y="515" width="200" height="16" override="replace">
        <text font="letterica16" align="l" r="250" g="250" b="250" a="150">ui_st_our_resource</text>
    </static_our_resource>
    <static_enemy_resource x="779" y="515" width="200" height="16" override="replace">
        <text font="letterica16" align="r" r="250" g="250" b="250" a="150">ui_st_enemy_resource</text>
    </static_enemy_resource>

    <progress_our_state x="280" y="272" width="220" height="57" min="0" max="100" pos="0" mode="horz" override="replace">
        <progress stretch="1">
            <texture color="pda_green">ui_pda2_big_progress</texture>
        </progress>
        <background stretch="1">
            <texture a="60">ui_pda2_big_progress</texture>
        </background>
    </progress_our_state>
    <progress_enemy_state x="524" y="272" width="220" height="57" min="0" max="100" pos="0" mode="back" override="replace">
        <progress stretch="1">
            <texture color="pda_green">ui_pda2_big_progress</texture>
        </progress>
        <background stretch="1">
            <texture a="60">ui_pda2_big_progress</texture>
        </background>
    </progress_enemy_state>

    <progress_our_mem_count x="45" y="450" width="455" height="38" min="0" max="100" pos="0" mode="horz" override="replace">
        <progress stretch="1">
            <texture color="pda_yellow">ui_pda2_small_progress</texture>
        </progress>
        <background stretch="1">
            <texture a="60">ui_pda2_small_progress</texture>
        </background>
    </progress_our_mem_count>
    <progress_enemy_mem_count x="524" y="450" width="455" height="38" min="0" max="100" pos="0" mode="back" override="replace">
        <progress stretch="1">
            <texture color="pda_yellow">ui_pda2_small_progress</texture>
        </progress>
        <background stretch="1">
